; HugoCMS – Mount-Konfiguration (Rückfall)
; ===========================================================================
; Diese Datei ist der RÜCKFALL: Sie greift, wenn für die aufgerufene Webseite
; keine eigene Datei mounts/<hash>.ini existiert (der Client erhält dann einen
; Einrichtungs-Hinweis). Pro Webseite eine eigene mounts/<hash>.ini anlegen;
; den Dateinamen liefert die 404-/Warnmeldung oder scripts/site-hash.sh.
;
; Format identisch für Rückfall und host-spezifische Dateien.
;
; Übergabe an den Connector:
;
;     $connector->mountsFromFile(__DIR__ . '/mounts.ini');
;
; Regeln:
;   • Jede [Sektion] ist ein Mount. Der Sektionsname ist die interne ID
;     (kurz, ohne Leer- und Sonderzeichen).
;   • path        (Pflicht)  Verzeichnis des Mounts. Relative Pfade gelten
;                            relativ zu DIESER Datei. Absolute Pfade empfohlen.
;   • label       (optional) Anzeigename im Client. Standard: Sektionsname.
;   • permissions (optional) Kommaliste. Werte: read, write, upload, delete,
;                            mkdir, rename, copy, move. Fehlt sie: alle Rechte.
;   • accept      (optional) Kommaliste erlaubter Endungen (ohne Punkt).
;                            Leer oder fehlend: alle Endungen erlaubt.
;   • readonly    (optional) true = nur Lesen (überschreibt permissions).
;
; Werte mit Sonderzeichen bei Bedarf in "doppelte Anführungszeichen" setzen.
; ===========================================================================

[content]
path = "/media/worker/extra/solar-spar.de/content"
label = "Inhalte"
accept = "md, markdown, html, htm, png, jpg, jpeg, gif, webp, svg"

[layouts]
path = "/media/worker/extra/solar-spar.de/layouts"
label = Vorlagen
permissions = read, write

[static]
path = "/media/worker/extra/solar-spar.de/static"
label = Medien

[projekt]
path = "/media/worker/extra/solar-spar.de/"
label = Alle Dateien

; Hugo-Aufruf für den Veröffentlichen-Knopf (Entwicklung). Das Hugo-Programm
; (bin) steht zentral in der hugocms.ini, nicht hier.

[hugo]
source = "/media/worker/extra/solar-spar.de"
destination = "/media/worker/extra/solar-spar.de/public"

