# Hugo-Binary (wird per bin/get-hugo.sh geholt, nicht versioniert)
bin/hugo/

# Instanzkonfiguration darf nicht ins Release-Repo gelangen. Die Vorlagen
# enden auf *.ini.beispiel und bleiben damit versioniert. Schutz zusätzlich
# zum Packaging (scripts/packaging.sh, Schritt 4b), falls hier eine Installation
# läuft oder das Skript einmal aussetzt.
*.ini
*.bak

# Werkzeugkonfiguration der Entwicklungsumgebung. Sie entsteht, sobald hier
# Claude Code läuft, und wird vom Packaging nicht entfernt — ohne diese Regel
# nähme das `git add -A` in Schritt 6 sie auf. `.mcp.json` enthält Zugangsdaten
# zu MCP-Servern und darf dieses öffentliche Repo nie erreichen.
.claude/
.mcp.json

# Log- und temporäre Dateien, die von der Instanz erzeugt werden. Sie werden
# vom Packaging entfernt, falls sie hier entstehen. Sie werden nicht versioniert,
# weil sie nicht für die Reproduktion der Instanz relevant sind.
backend/log/
backend/var/
